# SF WhatsApp Copilot — environment template.
# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Long-lived secrets (OAuth refresh tokens, client secret, WhatsApp token)
# should live in the macOS Keychain; leave them blank here once that's wired up.

# --- Backend ---
PORT=

# --- Salesforce hosted MCP (Phase 3) ---
# Defaults to https://api.salesforce.com/platform/mcp/v1/platform/sobject-reads
SF_MCP_URL=
# Consumer Key of the External Client App (not a secret, but keep it out of Git).
SF_CLIENT_ID=
# Defaults to 38000 (same callback as Claude Code: http://localhost:38000/callback)
SF_OAUTH_CALLBACK_PORT=
# The consumer secret and refresh token are NOT set here; they live in the Keychain
# (service "sf-whatsapp-copilot"). See README.

# --- Local AI (Phase 2) ---
# Defaults: http://127.0.0.1:11434 and qwen3.5:4b
OLLAMA_HOST=
OLLAMA_MODEL=

# --- Telegram bot (chat channel) ---
# Your numeric Telegram user ID; only this user can use the bot. Set by `npm run telegram:setup`.
# The bot token is NOT set here; it lives in the Keychain (sf-whatsapp-copilot / tg-bot-token).
TELEGRAM_ALLOWED_USER_ID=

# --- WhatsApp Cloud API (Phase 4, paused: Meta requires business verification) ---
# From Meta: WhatsApp > API Setup (test number's Phone number ID).
WHATSAPP_PHONE_NUMBER_ID=
# Only messages from this number are processed (country code + number, e.g. 919876543210).
WHATSAPP_ALLOWED_SENDER=
# Graph API version shown in Meta's API Setup sample request. Defaults to v25.0.
WHATSAPP_GRAPH_VERSION=
# Access token, App Secret and verify token are NOT set here; they live in the Keychain
# (service "sf-whatsapp-copilot": wa-access-token, wa-app-secret, wa-verify-token).

# --- Tunnel (Phase 4) ---
# Your free ngrok static domain, e.g. something.ngrok-free.app (used by `npm run tunnel`).
NGROK_DOMAIN=

# --- Safety (Phase 5) ---
MONTHLY_REPLY_LIMIT=

# SF WhatsApp Copilot — environment template.
# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Long-lived secrets (OAuth refresh tokens, client secret, WhatsApp token)
# should live in the macOS Keychain; leave them blank here once that's wired up.

# --- Backend ---
PORT=

# --- Salesforce hosted MCP (Phase 3) ---
# Developer Edition org -> login.salesforce.com, no /sandbox/ segment.
SF_MCP_URL=
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_OAUTH_CALLBACK_PORT=

# --- Local AI (Phase 2) ---
OLLAMA_HOST=
OLLAMA_MODEL=

# --- WhatsApp Cloud API (Phase 4) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Only messages from this number (E.164, digits only) are processed.
WHATSAPP_ALLOWED_SENDER=

# --- Safety (Phase 5) ---
MONTHLY_REPLY_LIMIT=

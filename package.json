{
  "name": "sf-whatsapp-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "login": "node src/cli.js login",
    "logout": "node src/cli.js logout",
    "tools": "node src/cli.js tools",
    "ask": "node src/cli.js ask",
    "test": "node --test test/*.test.js",
    "test:ollama": "node scripts/ollama-tool-test.mjs",
    "serve": "node src/serve.js",
    "simulate": "node scripts/simulate-webhook.mjs",
    "setup:verify-token": "node scripts/setup-verify-token.mjs",
    "tunnel": "node -e \"require('dotenv').config({quiet:true});const d=process.env.NGROK_DOMAIN;if(!d){console.error('Set NGROK_DOMAIN in .env');process.exit(1)}require('child_process').spawn('ngrok',['http','--url='+d,process.env.PORT||'3000'],{stdio:'inherit'})\"",
    "store-secret": "node scripts/store-secret.mjs",
    "bot": "node src/bot.js",
    "telegram:setup": "node scripts/telegram-setup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "18.0.8"
  }
}
